# TSMeet Docker environment
# Copy this file to .env before running: docker compose up -d --build
# Never commit .env. Replace every change-me value for production.

# -----------------------------------------------------------------------------
# Public application URLs
# Local Docker defaults are shown. Use https:// and wss:// public domains in production.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3001
MEETING_BASE_URL=http://localhost:3001
BACKEND_URL=http://backend:3002
# Browser signaling. In production use the FRONTEND origin; Nginx proxies
# /socket.io/ and Next.js proxies /api/* while preserving the session cookie.
NEXT_PUBLIC_SIGNALING_SERVER=http://localhost:3002
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
MINIO_PUBLIC_ENDPOINT=http://localhost:9100

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
DB_ROOT_PASSWORD=change-me-long-random-database-password
DB_HOST_PORT=13306
DB_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Authentication and meeting limits
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-at-least-32-random-characters
MAX_PARTICIPANTS=50
MAX_MESH_PARTICIPANTS=8

# -----------------------------------------------------------------------------
# Redis
# Leave REDIS_PASSWORD empty for local docker-compose.yml.
# A strong non-empty password is required with docker-compose.production.yml.
# The same production password must also be rendered into
# infrastructure/livekit/livekit.production.yaml from its example template.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Media provider rollout
# livekit is the scalable SFU default. mesh is intended only for small rollback rooms.
# -----------------------------------------------------------------------------
MEDIA_PROVIDER=livekit
MEDIA_PROVIDER_LIVEKIT_ROOMS=
MEDIA_PROVIDER_MESH_ROOMS=

# External STUN/TURN used only by legacy mesh rooms. LiveKit SFU rooms use the
# embedded TURN configuration in infrastructure/livekit/*.yaml.
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# -----------------------------------------------------------------------------
# LiveKit SFU and embedded TURN
# LIVEKIT_KEYS must contain the exact same key and secret as the next two values:
# LIVEKIT_KEYS=api-key: api-secret
# Production TURN domain/certificate paths are configured by rendering
# infrastructure/livekit/livekit.production.example.yaml to livekit.production.yaml.
# Open TCP 7880/7881/5349 and UDP 3478/7882 in production.
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=change-me-livekit-api-key
LIVEKIT_API_SECRET=change-me-long-random-livekit-secret
LIVEKIT_KEYS=change-me-livekit-api-key: change-me-long-random-livekit-secret

# -----------------------------------------------------------------------------
# Recording storage (MinIO) and LiveKit Egress
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=change-me-minio-access-key
MINIO_ROOT_PASSWORD=change-me-long-random-minio-secret
MINIO_BUCKET=tsmeet-recordings
MINIO_REGION=us-east-1
RECORDING_STORAGE_QUOTA_BYTES=107374182400
RECORDING_RETENTION_DAYS=30
RECORDER_SERVICE_TOKEN=change-me-long-random-recorder-token
# Base URL LiveKit Egress loads to render the composite layout. Leave empty to
# use the built-in default; set it when Egress cannot reach the frontend by its
# public URL (for example on an internal Compose network).
EGRESS_LAYOUT_URL=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-long-random-grafana-password
