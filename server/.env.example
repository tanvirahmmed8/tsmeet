NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://127.0.0.1:3002

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=videoconference
DB_POOL_SIZE=10

JWT_SECRET=change-this-to-a-long-random-secret

RECORDER_SERVICE_TOKEN=change-this-to-a-long-random-recorder-token
RECORDER_POLL_INTERVAL_MS=4000
RECORDER_SERVICE_INSTANCE_ID=tsmeet-recorder-1

# WebRTC mesh rooms should remain small. Use an SFU for larger meetings.
MAX_MESH_PARTICIPANTS=8
MEDIA_PROVIDER=livekit
MEDIA_PROVIDER_LIVEKIT_ROOMS=
MEDIA_PROVIDER_MESH_ROOMS=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace-with-a-local-api-key
LIVEKIT_API_SECRET=replace-with-a-random-local-api-secret

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=tsmeet-recordings
MINIO_ACCESS_KEY=replace-with-a-local-storage-key
MINIO_SECRET_KEY=replace-with-a-long-random-storage-secret
RECORDING_STORAGE_QUOTA_BYTES=107374182400
RECORDING_RETENTION_DAYS=30

STUN_SERVER=stun:turn.example.com:3478
TURN_SERVER=turn:turn.example.com:3478
TURN_USERNAME=turn-user
TURN_PASSWORD=turn-password
