{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["./node_modules", "../node_modules", "../.next"]
}
